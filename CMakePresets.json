{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "switch-release",
      "displayName": "Nintendo Switch Release",
      "description": "punktfunk.nro with deko3d; run inside the pf-switch-dev container (scripts/dev.sh), the repo mounted at /src.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/switch",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLATFORM_SWITCH": "ON",
        "USE_DEKO3D": "ON"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux desktop (development)",
      "description": "Off-console development build against system SDL2, FFmpeg, Opus, Jansson and libpng; also needs the pf-switch-dev container because punktfunk-rs/.cargo/config.toml expects /src.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLATFORM_DESKTOP": "ON",
        "MOONLIGHT_DESKTOP_USE_SYSTEM_PACKAGES": "ON",
        "USE_SDL2": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "switch-release",
      "configurePreset": "switch-release",
      "targets": [ "punktfunk.nro" ]
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "targets": [ "punktfunk" ]
    }
  ]
}
