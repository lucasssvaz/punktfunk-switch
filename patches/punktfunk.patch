+/// Probe with the caller's saved pin: offers `punktfunk/2` first (and `punktfunk/1` for older
+/// hosts), records the host leaf, and reports whether it matches `pin_sha256`. On a mismatch
+/// `observed_sha256_out` still receives the presented fingerprint, so the caller can show it.
+///
+/// # Safety
+/// `host` is a NUL-terminated UTF-8 string; `pin_sha256` is null or readable for 32 bytes;
+/// `observed_sha256_out` is null or writable for 32 bytes.
+#[cfg(feature = "quic")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn punktfunk_probe_ex(
+    host: *const std::os::raw::c_char,
+    port: u16,
+    pin_sha256: *const u8,
+    timeout_ms: u32,
+    observed_sha256_out: *mut u8,
+) -> PunktfunkStatus {
+    guard(|| {
+        // SAFETY: pointers are caller-supplied and null-checked on this path.
+        let Ok(Some(host)) = (unsafe { opt_cstr(host) }) else {
+            return PunktfunkStatus::NullPointer;
+        };
+        // SAFETY: non-null means readable for one `[u8; 32]` per the contract; alignment 1.
+        let pin = (!pin_sha256.is_null())
+            .then(|| unsafe { std::ptr::read_unaligned(pin_sha256.cast::<[u8; 32]>()) });
+        match punktfunk_core::client::NativeClient::probe_identity_ex(
+            host,
+            port,
+            pin,
+            std::time::Duration::from_millis(timeout_ms as u64),
+        ) {
+            Some(outcome) => {
+                // SAFETY: null or writable for 32 bytes (caller contract).
+                unsafe { put_sha256(observed_sha256_out, outcome.fingerprint) };
+                if outcome.matched {
+                    PunktfunkStatus::Ok
+                } else {
+                    PunktfunkStatus::Crypto
+                }
+            }
+            None => PunktfunkStatus::Timeout,
+        }
+    })
+}
